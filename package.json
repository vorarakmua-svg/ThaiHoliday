{
  "name": "thai-holiday-api",
  "version": "1.0.0",
  "private": true,
  "description": "Thai government holiday (วันหยุดราชการไทย) data, collected automatically and published as static JSON",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsx src/cli.ts build",
    "refresh": "tsx src/cli.ts refresh",
    "verify": "tsx src/cli.ts verify",
    "validate": "tsx src/cli.ts validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
